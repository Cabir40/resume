---
layout: base.njk
title: "Cabir Celik — Me"
nav: me
---
<div class="me-page">
  <article class="me-content">
    <section class="me-hero" id="about" aria-labelledby="about-heading">
      <p class="running-head">Me &middot; About</p>
      <div class="me-hero__grid">
        <img class="me-hero__avatar" src="{{ me.about.avatar }}" alt="Portrait of {{ me.about.name }}">
        <div>
          <h1 id="about-heading" class="me-hero__name">{{ me.about.name }}</h1>
          <p class="me-hero__title">{{ me.about.title }}</p>
          <p class="me-hero__location">{{ me.about.location }}</p>
          <ul class="badge-list">
            {% for badge in me.about.badges %}
            <li class="badge">{{ badge }}</li>
            {% endfor %}
          </ul>
          <ul class="profile-links">
            {% for profile in me.about.profiles %}
            <li><a href="{{ profile.url }}">{{ profile.label }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <div class="prose">{{ me.about.content | safe }}</div>
    </section>

    <section class="me-section" id="experience" aria-labelledby="experience-heading">
      <p class="running-head">Me &middot; Experience</p>
      <h2 id="experience-heading">Experience</h2>
      <ol class="timeline">
        {% for job in me.experience %}
        <li class="timeline-item">
          <p class="timeline-item__dates mono">{{ job.dates }}</p>
          <h3 class="timeline-item__role">{{ job.role }}</h3>
          <p class="timeline-item__org">{{ job.org }} &middot; {{ job.location }}</p>
          <div class="prose">{{ job.content | safe }}</div>
        </li>
        {% endfor %}
      </ol>
    </section>

    <section class="me-section" id="education" aria-labelledby="education-heading">
      <p class="running-head">Me &middot; Education</p>
      <h2 id="education-heading">Education</h2>
      <ol class="timeline">
        {% for degree in me.education %}
        <li class="timeline-item">
          <p class="timeline-item__dates mono">{{ degree.dates }}</p>
          <h3 class="timeline-item__role">{{ degree.degree }}</h3>
          <p class="timeline-item__org">{{ degree.institution }} &middot; {{ degree.location }}</p>
          {% if degree.thesis %}
          <blockquote class="thesis">
            <p class="thesis__title">{{ degree.thesis.title }}</p>
            <p class="thesis__citation mono">{{ degree.thesis.citation }}</p>
          </blockquote>
          {% endif %}
          <div class="prose">{{ degree.content | safe }}</div>
        </li>
        {% endfor %}
      </ol>
    </section>

    <section class="me-section" id="publications" aria-labelledby="publications-heading">
      <p class="running-head">Me &middot; Publications</p>
      <h2 id="publications-heading">Publications</h2>
      <ol class="pub-list">
        {% for pub in me.publications %}
        <li class="pub-item">
          <p class="pub-item__tag mono">{{ pub.tag }}</p>
          <h3 class="pub-item__title">
            {% if pub.link %}<a href="{{ pub.link }}">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif %}
          </h3>
          <p class="pub-item__venue mono">{{ pub.venue }}</p>
          <div class="prose">{{ pub.content | safe }}</div>
        </li>
        {% endfor %}
      </ol>
    </section>

    <section class="me-section" id="projects" aria-labelledby="projects-heading">
      <p class="running-head">Me &middot; Projects</p>
      <h2 id="projects-heading">Projects</h2>
      <ul class="project-grid">
        {% for project in me.projects %}
        <li class="project-card">
          <h3 class="project-card__title">{{ project.title }}</h3>
          <p class="project-card__stack mono">{{ project.stack }}</p>
          <div class="prose">{{ project.content | safe }}</div>
          <p class="project-card__links">
            {% if project.demo %}<a href="/project-demos/{{ project.demo }}/">Project demo &rarr;</a>{% endif %}
            {% if project.link %}<a href="{{ project.link }}">Source &rarr;</a>{% endif %}
          </p>
        </li>
        {% endfor %}
      </ul>
    </section>

    <section class="me-section" id="contact" aria-labelledby="contact-heading">
      <p class="running-head">Me &middot; Contact</p>
      <h2 id="contact-heading">{{ me.contact.heading }}</h2>
      <div class="prose">{{ me.contact.content | safe }}</div>
      <ul class="profile-links">
        {% for profile in me.contact.profiles %}
        <li><a href="{{ profile.url }}">{{ profile.label }}</a></li>
        {% endfor %}
      </ul>
      <ul class="language-list mono">
        {% for language in me.contact.languages %}
        <li>{{ language }}</li>
        {% endfor %}
      </ul>
    </section>
  </article>

  <nav class="me-sidebar" aria-label="On this page">
    <p class="me-sidebar__heading mono">On this page</p>
    <ol class="me-sidebar__list">
      <li><a href="#about">01 &middot; About</a></li>
      <li><a href="#experience">02 &middot; Experience</a></li>
      <li><a href="#education">03 &middot; Education</a></li>
      <li><a href="#publications">04 &middot; Publications</a></li>
      <li><a href="#projects">05 &middot; Projects</a></li>
      <li><a href="#contact">06 &middot; Contact</a></li>
    </ol>
  </nav>
</div>
